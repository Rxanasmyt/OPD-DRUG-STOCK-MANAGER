# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Firebase Console > Project settings > General > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ตั้งเป็น true เพื่อให้ `npm run dev` ต่อ Firebase Local Emulator Suite แทน production
# (ต้องรัน `npm run emulators` อีก terminal หนึ่งคู่กัน) — ค่า VITE_FIREBASE_* ด้านบนใส่เป็นค่าอะไรก็ได้
# ตอนใช้ emulator เพราะไม่ได้ต่อ production จริง แค่ projectId ต้องตรงกับใน .firebaserc
VITE_USE_EMULATOR=false
