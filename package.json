{
  "name": "opd-pharmacy-stock-pwa",
  "private": true,
  "version": "0.1.0",
  "description": "PWA จัดการสต็อกยา ห้องยาผู้ป่วยนอก (Substock → Floor stock) — React + Firebase",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "seed": "node scripts/seed.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes,functions"
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^12.7.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  },
  "engines": {
    "node": ">=18"
  }
}
