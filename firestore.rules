rules_version = '2';

// Paste this whole file into: Firebase Console → your project → Firestore Database
// → Rules tab → replace everything → Publish.
//
// Model: every signed-in Firebase Auth user gets a profile doc at
// users/{uid}. New accounts are created with role:'tech', active:false
// (pending). Nothing in meds/lots/txs/auditLog is readable or writable
// until an admin flips a user's `active` to true. The very first admin
// account has to be promoted by hand once, directly in the Firestore
// "Data" tab (see README) — there is no user yet to approve the first one.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return signedIn() && myProfile().active == true; }
    function isAdmin() { return isActive() && myProfile().role == 'admin'; }
    function isPharmOrAdmin() { return isActive() && (myProfile().role == 'pharm' || myProfile().role == 'admin'); }
    // Bug fix (security audit, CRITICAL): a double's wire format supports Infinity, and CEL's
    // comparison follows IEEE-754 — `Infinity >= 0` is true, so this used to let ANY active
    // user (including the lowest-trust `tech` role) write `floor`/`qty: Infinity` straight via
    // the SDK (e.g. devtools `updateDoc`), bypassing every client-side guard and poisoning every
    // downstream sum/comparison (par suggestions, low-stock flags, printed requisitions, reports)
    // with Infinity/NaN. The upper bound is far above any real stock count (client caps numeric
    // input at 9 digits — see utils/format.ts's digitsOnly) but still finite, closing the hole
    // without touching any legitimate write.
    function isNonNegNum(v) { return v is number && v >= 0 && v < 1000000000000000; }

    // ---- user profiles ----
    match /users/{uid} {
      // Anyone signed in can create their OWN profile once, at registration —
      // and only as an unapproved, non-privileged account. The server (rules)
      // forces role/active here so a client can't self-promote to admin.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.active == false
                    && request.resource.data.role == 'tech';

      // A user can read their own profile (to know if they're approved yet);
      // an admin can read/list anyone's (for the approvals screen).
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // A signed-in user may update only their own `lastLogin` field.
      // Only an admin may change role/active (approve, promote, disable).
      // Bug fix (security audit, ENHANCEMENT — defense in depth): the isAdmin() branch used to
      // allow writing ANY value to role/active with no type/enum check at all — a client bug (or
      // a compromised admin session) could write a junk `role` string that breaks every
      // `role === 'x'` check app-wide. Only constrains role/active WHEN they're actually part of
      // this write's diff, so every other admin field edit is unaffected.
      allow update: if (isAdmin()
                         && (!('role' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.role in ['admin', 'pharm', 'tech'])
                         && (!('active' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.active is bool))
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']));

      allow delete: if false;
    }

    // ---- username -> uid claims (login is by username, not email) ----
    // Publicly readable one-at-a-time (needed to check "is this username taken" before
    // signup, and a single username's existence isn't sensitive), but a username can only
    // ever be claimed once: the doc ID is the username, and create only matches the doc not
    // existing yet — once claimed, any further write is treated as an "update" and blocked
    // below.
    // Bug fix (security): `allow read` grants both `get` (check one username) AND `list`
    // (query the whole collection) — the app itself only ever does the former (see
    // AppContext.tsx's signup flow), but the blanket rule let anyone with no account at all
    // dump every username in the hospital system in one unauthenticated query, no guessing
    // needed — real enumeration, not just a theoretical gap. `allow get` alone still serves
    // every real use of this collection.
    match /usernames/{uname} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- master drug data: any approved staff can read. Any approved staff can also
    // update just `floor`/`lastCountTs`/`lastSubCountTs` (day-to-day stock movement —
    // transfer, adjust, count, HOSxP reconcile all touch only these; lastSubCountTs is its
    // own field, separate from lastCountTs, because floor and substock cycle counts are
    // tracked on independent staleness clocks — see CountScreen.tsx/commitSubCount in
    // AppContext.tsx). Everything else about a drug's record — creating one, deleting one,
    // par/bin/price/name/active/high-alert — real-world request: Admin only now (was
    // pharm/admin) — a pharmacist still edits day-to-day floor/count via the isActive()
    // branch below same as tech, just not the master record itself. ----
    match /meds/{medId} {
      allow read: if isActive();
      // Bug fix (audit finding): create had NO schema check at all — any admin-level write
      // (including a buggy script or a compromised admin session, not just addMed()'s own form)
      // could create a med doc with any field set/types whatsoever, since the admin OR-branch
      // of `allow update` below already has no field restriction either and `allow create` had
      // none of its own. hasOnly() here is the exact field union verified against addMed()'s one
      // real create write (AppContext.tsx) — `code, name, unit, dosageForm, price, had, active,
      // fridge?, parSub, parFloor, floor, floorMin, bin, used30, usedPrev30, volatility,
      // lastCountTs, ward, noSubstock, shared?, binIpd?, binSub?, category?, packSize?, route?`
      // (the `?` fields are the ones that write conditionally omits rather than always sending).
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly([
                         'code', 'name', 'unit', 'dosageForm', 'price', 'had', 'active',
                         'fridge', 'parSub', 'parFloor', 'floor', 'floorMin', 'bin',
                         'used30', 'usedPrev30', 'volatility', 'lastCountTs', 'ward',
                         'noSubstock', 'shared', 'binIpd', 'binSub', 'category', 'packSize', 'route'
                       ])
                    && request.resource.data.code is string
                    && request.resource.data.name is string
                    && request.resource.data.unit is string
                    && request.resource.data.dosageForm is string
                    && isNonNegNum(request.resource.data.price)
                    && request.resource.data.had is bool
                    && request.resource.data.active is bool
                    && isNonNegNum(request.resource.data.parSub)
                    && isNonNegNum(request.resource.data.parFloor)
                    && isNonNegNum(request.resource.data.floor)
                    && isNonNegNum(request.resource.data.floorMin)
                    && request.resource.data.bin is string
                    && isNonNegNum(request.resource.data.used30)
                    && isNonNegNum(request.resource.data.usedPrev30)
                    && request.resource.data.volatility is number
                    && request.resource.data.lastCountTs is number
                    && request.resource.data.ward in ['opd', 'ipd']
                    && request.resource.data.noSubstock is bool
                    && (!('fridge' in request.resource.data) || request.resource.data.fridge is bool)
                    && (!('shared' in request.resource.data) || request.resource.data.shared is bool)
                    && (!('binIpd' in request.resource.data) || request.resource.data.binIpd is string)
                    && (!('binSub' in request.resource.data) || request.resource.data.binSub is string)
                    && (!('category' in request.resource.data) || request.resource.data.category is string)
                    && (!('packSize' in request.resource.data) || isNonNegNum(request.resource.data.packSize))
                    && (!('route' in request.resource.data) || request.resource.data.route is string);
      allow delete: if isAdmin();
      // Bug fix: this branch type-checked `floor` but not `lastCountTs`/`lastSubCountTs`,
      // inconsistent with the `lots` rule right below which type-checks every field it allows.
      // A malformed value here (string/null from a client bug or stale cache) would corrupt the
      // "days since last count" staleness calculations reports/selectors read from these fields.
      //
      // Bug fix (privilege escalation): every LEGITIMATE non-admin write to these fields
      // (commitCount/commitSubCount in AppContext.tsx) sets lastCountTs/lastSubCountTs to a
      // real Date.now() number — the only place that ever DELETES them is
      // resetAllQuantities(), which is admin-gated client-side (double confirm + typed "RESET"
      // + a pre-write backup to _preResetSnapshots) precisely because it's a hospital-wide,
      // unaudited wipe. But this rule only checked the TYPE of these fields when present —
      // deleteField() removes a field entirely, so resetAllQuantities' own exact payload
      // (`{floor: 0, lastCountTs: deleteField(), lastSubCountTs: deleteField()}`) satisfied
      // this branch just as well as a real tech's single-med count, with no role check at all.
      // Any active tech, calling the Firestore SDK directly from devtools (bypassing the admin
      // gate, the confirmations, AND the backup snapshot), could batch-zero every med's floor
      // hospital-wide with zero audit trail. Requiring that a field which already existed on
      // the med can never be REMOVED by this branch closes that exact payload shape — a
      // resetAllQuantities-style bulk wipe (or any single-doc equivalent) now needs isAdmin().
      //
      // Bug fix (audit finding): the isAdmin() OR-branch below used to be a bare `isAdmin()` —
      // any admin-level write (also a buggy script/compromised admin session, not just the
      // app's own actions) could touch ANY field, including `code` (which updateMedFull's own
      // doc comment says is "deliberately never touched" post-creation — the QR/label
      // identifier every printed label and scan lookup keys off of). hasOnly() here is the
      // verified union of every real admin write site in AppContext.tsx (updateMedFull,
      // applyOnePar/applyAllSuggested/setAllMinHalfOfMax/setAllMinSuggested/debouncedParWrite,
      // setMedBin/setMedBinSub/setMedCategory/setMedRoute, recomputeUsageStats,
      // analyzeWeekdayUsage/clearMedWeekdayPattern/clearMedPeakDay, mergeWardMeds/
      // mergeAllWardPairs, shareAllMeds/autoCategorizeAll/autoRouteAll, toggleMedActive,
      // startStockHold/endStockHold, commitUsageImport) — `code` is deliberately NOT in this
      // list, so any write attempting to change it is rejected outright, closing that gap
      // without an extra equality check. Every field here is individually type-checked only
      // when it's actually part of this write's diff (same pattern users' own role/active
      // guard above uses), since no single admin action touches all of them at once.
      allow update: if (isAdmin()
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                              'name', 'unit', 'dosageForm', 'price', 'had', 'fridge', 'bin',
                              'parSub', 'parFloor', 'floor', 'floorMin', 'used30', 'usedPrev30',
                              'volatility', 'ward', 'noSubstock', 'shared', 'binIpd', 'binSub',
                              'category', 'packSize', 'route', 'active', 'mergedInto',
                              'outOfStockSince', 'outOfStockReason', 'outOfStockExpectedReturn',
                              'weekdayPeakFactor', 'weekdayPeakDay', 'weekdayPeakOccurrences',
                              'weekdayPattern', 'peakDayQty', 'peakDayDate'
                            ])
                         && (!('name' in request.resource.data) || request.resource.data.name is string)
                         && (!('unit' in request.resource.data) || request.resource.data.unit is string)
                         && (!('dosageForm' in request.resource.data) || request.resource.data.dosageForm is string)
                         && (!('price' in request.resource.data) || isNonNegNum(request.resource.data.price))
                         && (!('had' in request.resource.data) || request.resource.data.had is bool)
                         && (!('fridge' in request.resource.data) || request.resource.data.fridge is bool)
                         && (!('bin' in request.resource.data) || request.resource.data.bin is string)
                         && (!('parSub' in request.resource.data) || isNonNegNum(request.resource.data.parSub))
                         && (!('parFloor' in request.resource.data) || isNonNegNum(request.resource.data.parFloor))
                         && (!('floor' in request.resource.data) || isNonNegNum(request.resource.data.floor))
                         && (!('floorMin' in request.resource.data) || isNonNegNum(request.resource.data.floorMin))
                         && (!('used30' in request.resource.data) || isNonNegNum(request.resource.data.used30))
                         && (!('usedPrev30' in request.resource.data) || isNonNegNum(request.resource.data.usedPrev30))
                         && (!('volatility' in request.resource.data) || request.resource.data.volatility is number)
                         && (!('ward' in request.resource.data) || request.resource.data.ward in ['opd', 'ipd'])
                         && (!('noSubstock' in request.resource.data) || request.resource.data.noSubstock is bool)
                         && (!('shared' in request.resource.data) || request.resource.data.shared is bool)
                         && (!('binIpd' in request.resource.data) || request.resource.data.binIpd is string)
                         && (!('binSub' in request.resource.data) || request.resource.data.binSub is string)
                         && (!('category' in request.resource.data) || request.resource.data.category is string)
                         && (!('packSize' in request.resource.data) || isNonNegNum(request.resource.data.packSize))
                         && (!('route' in request.resource.data) || request.resource.data.route is string)
                         && (!('active' in request.resource.data) || request.resource.data.active is bool)
                         && (!('mergedInto' in request.resource.data) || request.resource.data.mergedInto is string)
                         && (!('outOfStockSince' in request.resource.data) || request.resource.data.outOfStockSince is number)
                         && (!('outOfStockReason' in request.resource.data) || request.resource.data.outOfStockReason is string)
                         && (!('outOfStockExpectedReturn' in request.resource.data) || request.resource.data.outOfStockExpectedReturn is number)
                         && (!('weekdayPeakFactor' in request.resource.data) || request.resource.data.weekdayPeakFactor is number)
                         && (!('weekdayPeakDay' in request.resource.data) || request.resource.data.weekdayPeakDay is number)
                         && (!('weekdayPeakOccurrences' in request.resource.data) || request.resource.data.weekdayPeakOccurrences is number)
                         && (!('weekdayPattern' in request.resource.data) || request.resource.data.weekdayPattern is list)
                         && (!('peakDayQty' in request.resource.data) || request.resource.data.peakDayQty is number)
                         && (!('peakDayDate' in request.resource.data) || request.resource.data.peakDayDate is string))
                    || (isActive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['floor', 'lastCountTs', 'lastSubCountTs'])
                        && isNonNegNum(request.resource.data.floor)
                        && (!('lastCountTs' in resource.data) || 'lastCountTs' in request.resource.data)
                        && (!('lastSubCountTs' in resource.data) || 'lastSubCountTs' in request.resource.data)
                        && (!('lastCountTs' in request.resource.data) || request.resource.data.lastCountTs is number)
                        && (!('lastSubCountTs' in request.resource.data) || request.resource.data.lastSubCountTs is number))
                    // Real-world request: "ให้ admin และเภสัชกรเป็นคนตัดยอด" — commitReconcile()
                    // (AppContext.tsx) now auto-triggers recomputeUsageStats()/analyzeWeekdayUsage()
                    // right after a HOSxP reconcile, and a pharmacist routinely performs that
                    // reconcile, not just an admin. Narrow carve-out, same isPharmOrAdmin() role
                    // set already used for pendingReceives' approve/reject below — ONLY the derived
                    // usage-stat fields those 2 functions write (never par/price/name/bin/... —
                    // those stay admin-only via the isAdmin() branch above), same type checks as
                    // that branch's own copy of these fields.
                    || (isPharmOrAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'used30', 'usedPrev30', 'weekdayPeakFactor', 'weekdayPeakDay',
                           'weekdayPeakOccurrences', 'weekdayPattern', 'peakDayQty', 'peakDayDate'
                         ])
                        && (!('used30' in request.resource.data) || isNonNegNum(request.resource.data.used30))
                        && (!('usedPrev30' in request.resource.data) || isNonNegNum(request.resource.data.usedPrev30))
                        && (!('weekdayPeakFactor' in request.resource.data) || request.resource.data.weekdayPeakFactor is number)
                        && (!('weekdayPeakDay' in request.resource.data) || request.resource.data.weekdayPeakDay is number)
                        && (!('weekdayPeakOccurrences' in request.resource.data) || request.resource.data.weekdayPeakOccurrences is number)
                        && (!('weekdayPattern' in request.resource.data) || request.resource.data.weekdayPattern is list)
                        && (!('peakDayQty' in request.resource.data) || request.resource.data.peakDayQty is number)
                        && (!('peakDayDate' in request.resource.data) || request.resource.data.peakDayDate is string));
    }
    // ---- lots: any approved staff can read/write (receiving, FEFO transfer, scrap
    // all touch lots as part of normal day-to-day work, not just pharm/admin). Schema-checked
    // (not just role-checked) since this is a shared-write collection — a real stock quantity,
    // not just a UI-hidden field, so it's worth blocking obviously-malformed writes (negative/
    // non-numeric qty, wrong-typed medId) at the database layer too, not just in client JS. ----
    match /lots/{lotId} {
      allow read: if isActive();
      // Bug fix (audit finding): this used to type-check medId/qty/exp on create but never
      // lotNo, even though the `Lot` interface (types.ts) declares it required and the update
      // rule right below ASSUMES it was already a real string by locking it immutable
      // (`request.resource.data.lotNo == resource.data.lotNo`) — the one gap in this collection's
      // own stated "schema-checked, not just role-checked" goal. Matches floorLots' identical
      // create rule just below, which already checks this.
      // Bug fix (audit finding): `code`/`loc` are real, always-written fields (see every
      // lot-creation call site in AppContext.tsx — commitTransfer/commitReceive/
      // approvePendingReceive/commitSubCount all send exactly {code, medId, lotNo, exp, qty,
      // loc}) that were never type-checked, and nothing capped the field set at all — any
      // active user could stuff arbitrary extra fields into a new lot doc. hasOnly() here is
      // the exact 6-field shape verified against every real write path, so no legitimate write
      // is affected.
      allow create: if isActive()
                    && request.resource.data.keys().hasOnly(['code', 'medId', 'lotNo', 'qty', 'exp', 'loc'])
                    && request.resource.data.code is string
                    && request.resource.data.medId is string
                    && request.resource.data.lotNo is string
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.exp is number
                    && request.resource.data.loc is string;
      // Bug fix (audit finding — real production hardening, not just type-checking): this used
      // to only type-check medId/qty/exp on every update, with no restriction on WHICH fields
      // could actually change or by how much — any active (tech-level) account calling the
      // Firestore SDK directly (devtools, a buggy/compromised third-party script) could freely
      // reassign a lot to a completely different med, or rewrite its qty to anything, with
      // nothing here distinguishing that from a real app action and no required txs row either.
      // scripts/check-stock-drift.mjs (the daily automated drift check) would eventually catch
      // the resulting discrepancy, but only up to 24h later and without attributing WHAT caused
      // it. Every real write path in this app updates lots in exactly one of two shapes — see
      // AppContext.tsx's commitTransfer/commitReceive/approvePendingReceive/scrapLot/
      // commitSubCount (qty only: a transfer, receive-merge, scrap, or count) and
      // mergeWardMeds/mergeAllWardPairs (medId only: reassigning a lot to the surviving med
      // during a ward merge) — never both in the same write, and lotNo/exp never change once a
      // lot exists (a different batch always gets its own new lot doc instead). Locking the
      // rule to exactly that shape closes the "any field, any value" gap without needing to
      // guess at a legitimate quantity ceiling (a real receipt or count can legitimately be any
      // size), which is the one part of this finding not addressed here on purpose.
      allow update: if isActive()
                    && request.resource.data.medId is string
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.exp is number
                    && request.resource.data.lotNo == resource.data.lotNo
                    && request.resource.data.exp == resource.data.exp
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'medId']);
      // Bug fix: the app itself never deletes a lot doc — every real depletion (scrap, transfer,
      // count) zeroes `qty` via a transaction that also logs a matching txs row, same pattern the
      // update rule above enforces the shape of. Letting any active (tech-level) user outright
      // delete a lot doc had no matching app feature, no schema check, and no audit requirement —
      // real stock could vanish with zero trace. Admin-only, matching every other destructive
      // action in this file (meds delete, resetAllStockLedgers' txs delete).
      allow delete: if isAdmin();
    }

    // ---- floorLots: mirrors the `lots` rule immediately above, but for stock already moved
    // onto the ward floor (see FloorLot in types.ts for why this is a separate collection from
    // `lots` rather than a stage flag on it). Written by the same day-to-day flows as `lots` —
    // commitTransfer (creates/merges one per batch drawn), commitReconcile (best-effort FEFO
    // deduction from HOSxP's dispensed number), scrapFloorLot (admin/pharm bookkeeping cleanup)
    // — so the same isActive() role gate and schema shape apply. lotNo/exp never change once a
    // doc exists, same as `lots`; medId is included in affectedKeys() for the same forward-
    // compatibility reason as `lots`, even though no current write path ever actually reassigns
    // it. ----
    match /floorLots/{lotId} {
      allow read: if isActive();
      // Bug fix (audit finding): hasOnly() added — the one real write path (AppContext.tsx's
      // commitTransfer, via a deterministic-id trx.set()) always sends exactly these 4 fields,
      // verified against every call site; closes the same "arbitrary extra fields" gap as `lots`.
      allow create: if isActive()
                    && request.resource.data.keys().hasOnly(['medId', 'lotNo', 'qty', 'exp'])
                    && request.resource.data.medId is string
                    && request.resource.data.lotNo is string
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.exp is number;
      allow update: if isActive()
                    && request.resource.data.medId is string
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.exp is number
                    && request.resource.data.lotNo == resource.data.lotNo
                    && request.resource.data.exp == resource.data.exp
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'medId']);
      // The app itself never deletes a floorLots doc — scrapFloorLot() zeroes `qty` via the
      // update rule above, same as scrapLot() does for `lots`. Admin-only, matching `lots`.
      allow delete: if isAdmin();
    }

    // ---- transactions: append-only for everyone EXCEPT one admin-only escape hatch.
    // Schema-checked on create — this is the audit ledger the app treats as authoritative
    // history, so a malformed/fabricated entry (wrong-typed qty, no `by`/`ts`) shouldn't be
    // acceptable just because the writer is a signed-in active user. ----
    match /txs/{txId} {
      allow read: if isActive();
      // Bug fix (audit finding): hasOnly() caps the field set to the exact 12-field union used
      // across every real txs write in AppContext.tsx (verified against all 15 call sites) —
      // closes "stuff arbitrary extra fields into an audit-trail entry". `by == myProfile().name`
      // closes a separate forgery gap: any active user could previously addDoc a tx attributed
      // to someone else's name (by itself was only type-checked, never tied to the real caller) —
      // the entry can't be edited/deleted after (see allow update/delete below), but it could be
      // planted. myProfile().name is exactly what every real write already sends (see
      // AppContext.tsx's userName() == myProfile?.name), so no legitimate write is affected.
      // coveredFrom/coveredTo added for commitReconcile()'s real covered-date-range tracking
      // (see Tx.coveredFrom/coveredTo's own doc comment, types.ts) — only ever set on a
      // reconcile_hosxp row, but not worth a narrower per-type check here (this rule never
      // branches on `type`, same as every other field in this hasOnly() set).
      allow create: if isActive()
                    && request.resource.data.keys().hasOnly(['type', 'name', 'medId', 'qty', 'unit', 'by', 'ts', 'reason', 'note', 'loc', 'from', 'to', 'coveredFrom', 'coveredTo'])
                    && request.resource.data.type is string
                    && request.resource.data.qty is number
                    && request.resource.data.by == myProfile().name
                    && request.resource.data.ts is number
                    && (!('coveredFrom' in request.resource.data) || request.resource.data.coveredFrom is string)
                    && (!('coveredTo' in request.resource.data) || request.resource.data.coveredTo is string);
      allow update: if false;
      // Admin-only exception for resetAllStockLedgers() (AppContext.tsx) — the go-live
      // "start the system over" action that wipes the substock card ledger/report/usage-rate
      // history for every drug at once (current floor/lot quantities are never touched by it —
      // see that function's own doc comment). Everyone else, including a signed-in
      // pharm/tech, still can never delete a tx once written; only an admin, and only via that
      // one deliberate, double-confirmed action.
      allow delete: if isAdmin();
    }
    match /auditLog/{entryId} {
      allow read: if isActive();
      // Bug fix (audit finding): same two fixes as txs' create rule just above — hasOnly() on
      // the exact 4-field shape logAudit() always sends, and `by` tied to the real caller's
      // profile name instead of being a bare type-checked (forgeable) string.
      allow create: if isActive()
                    && request.resource.data.keys().hasOnly(['type', 'by', 'ts', 'note'])
                    && request.resource.data.type is string
                    && request.resource.data.note is string
                    && request.resource.data.by == myProfile().name
                    && request.resource.data.ts is number;
      allow update, delete: if false;
    }

    // ---- receives submitted by a ผู้ช่วยเภสัชกร (tech), waiting on a pharmacist/admin to
    // approve before they touch real stock. Any active staff can read (a tech needs to see
    // their own request's status) and create their own (status must start 'pending', and the
    // requester field must be themself — no submitting on someone else's behalf, no
    // pre-approving your own request). Only pharm/admin can update (approve/reject) — a tech
    // is intentionally excluded even from touching their own submission after the fact. ----
    match /pendingReceives/{id} {
      allow read: if isActive();
      // Bug fix: unlike every other shared-write collection here (txs/auditLog check every
      // field's type — see txs's own comment on why), this only ever checked
      // requestedByUid/status, leaving medId/qty/exp/lotNo/name/unit completely unconstrained.
      // A pendingReceives doc is exactly the kind of thing the txs comment warns about: a
      // low-privilege (tech) writer whose data later gets blindly applied to real stock —
      // approvePendingReceive() (AppContext.tsx) does `increment(pr.qty)` on a med's floor and
      // copies these same fields straight into a new txs row. A malformed qty/medId here used
      // to surface only as a confusing failed-transaction error at approval time instead of
      // being rejected up front, at the point it was actually written.
      // Bug fix (audit finding): added type checks for `recvNo`/`requestedBy` (previously
      // completely unconstrained, despite being required fields on the PendingReceive type and
      // always sent by the one real write path — see AppContext.tsx's `commitReceive`), tied
      // `requestedBy` to the real caller's profile name (same forgery fix as txs/auditLog
      // above), and capped the field set with hasOnly() to the exact 11-field shape verified
      // against that write site.
      allow create: if isActive()
                    && request.resource.data.keys().hasOnly(['recvNo', 'medId', 'name', 'unit', 'lotNo', 'exp', 'qty', 'requestedBy', 'requestedByUid', 'status', 'ts'])
                    && request.resource.data.requestedByUid == request.auth.uid
                    && request.resource.data.requestedBy == myProfile().name
                    && request.resource.data.status == 'pending'
                    && request.resource.data.recvNo is string
                    && request.resource.data.medId is string
                    && request.resource.data.name is string
                    && request.resource.data.unit is string
                    && request.resource.data.lotNo is string
                    && request.resource.data.exp is number
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.ts is number;
      // Bug fix (security audit, CRITICAL): this used to allow a pharm/admin to change ANY
      // field, including medId/qty/lotNo/exp, before "approving" — and nothing stopped the
      // original requester from approving their own (by then tampered) request. Concretely: an
      // authenticated pharm could create a small legitimate-looking pending receive for
      // themselves, then `updateDoc` the qty/medId to anything via devtools before clicking
      // approve — fabricating real stock with no further compromise needed.
      // approvePendingReceive()/rejectPendingReceive() (AppContext.tsx) only ever change
      // status/resolvedBy/resolvedTs/rejectReason — verified against both call sites — so
      // locking the diff to exactly those fields, freezing medId/qty/lotNo/exp at their
      // created values, requiring the doc to still be 'pending', and blocking the requester from
      // resolving their own request closes the hole without affecting the real approve/reject
      // flow at all.
      allow update: if isPharmOrAdmin()
                    && resource.data.status == 'pending'
                    && request.auth.uid != resource.data.requestedByUid
                    && request.resource.data.medId == resource.data.medId
                    && request.resource.data.qty == resource.data.qty
                    && request.resource.data.lotNo == resource.data.lotNo
                    && request.resource.data.exp == resource.data.exp
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedTs', 'rejectReason']);
      allow delete: if false;
    }

    // ---- shared settings (expiry warning days, par cover days) — real-world request:
    // Admin only now (was pharm/admin) ----
    match /meta/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- daily KPI snapshots (scripts/collect-daily-metrics.mjs, see types.ts:DailyMetrics)
    // ---- written once/day by a GitHub Actions cron job using the service-account credentials
    // (which bypass these rules entirely, same as backup-firestore.mjs/notify-low-stock.mjs) —
    // never by the app itself, so client writes are denied outright rather than scoped to a
    // role. Any active user can read it (report/KPI screen). ----
    match /dailyMetrics/{date} {
      allow read: if isActive();
      allow write: if false;
    }

    // ---- usage history (AppContext.tsx: commitUsageImport, see UsageHistoryRecord in types.ts)
    // ---- the durable, append-only per-period qty/value record behind the "📈 สถิติการใช้ยา"
    // report tab. Written in the SAME action/batch as the admin-only meds.used30 update right
    // above (SettingsScreen gates that whole import UI to admin — see its own "Admin-only now"
    // comment) — matching that same isAdmin() gate here, not a wider isActive(), keeps this
    // collection's write path exactly as privileged as the used30 write it always travels with.
    // Append-only like txs: never updated, never deleted by the app (a wrong import is a new
    // record, not an edit — the report tab's own "ไม่ถูกทับด้วยการนำเข้ารอบใหม่" guarantee would
    // break the moment this allowed update/delete). ----
    match /usageHistory/{id} {
      allow read: if isActive();
      // Bug fix (audit finding): hasOnly() added — matches UsageHistoryRecord's exact field set
      // (types.ts), verified against the one real write path (AppContext.tsx commitUsageImport).
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['medId', 'medName', 'unit', 'category', 'qty', 'value', 'periodFrom', 'periodTo', 'periodDays', 'importedAt', 'monthKey'])
                    && request.resource.data.medId is string
                    && request.resource.data.medName is string
                    && request.resource.data.unit is string
                    && request.resource.data.category is string
                    && isNonNegNum(request.resource.data.qty)
                    && isNonNegNum(request.resource.data.value)
                    && request.resource.data.periodFrom is string
                    && request.resource.data.periodTo is string
                    && request.resource.data.periodDays is number
                    && request.resource.data.importedAt is number
                    && request.resource.data.monthKey is string;
      allow update, delete: if false;
    }

    // ---- par-adjustment outcomes (AppContext.tsx: applyOnePar/applyAllSuggested, see
    // ParAdjustmentRecord in types.ts) — same reasoning as usageHistory right above: written in
    // the SAME action as the meds.parFloor/parSub update (canEditMeds is admin-only — see its
    // own definition), append-only so a later "did it stabilize?" check can never find its own
    // evidence edited or deleted out from under it. ----
    match /parAdjustments/{id} {
      allow read: if isActive();
      // Bug fix (audit finding): hasOnly() added (exact field set verified against
      // applyOnePar/applyAllSuggested's write sites), and `adjustedBy` tied to the real caller's
      // profile name — same forgery fix applied to txs/auditLog/pendingReceives above.
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['medId', 'medName', 'category', 'beforeFloor', 'beforeSub', 'afterFloor', 'afterSub', 'used30AtAdjust', 'usedPrev30AtAdjust', 'adjustedAt', 'adjustedBy'])
                    && request.resource.data.medId is string
                    && request.resource.data.medName is string
                    && request.resource.data.category is string
                    && isNonNegNum(request.resource.data.beforeFloor)
                    && isNonNegNum(request.resource.data.beforeSub)
                    && isNonNegNum(request.resource.data.afterFloor)
                    && isNonNegNum(request.resource.data.afterSub)
                    && isNonNegNum(request.resource.data.used30AtAdjust)
                    && isNonNegNum(request.resource.data.usedPrev30AtAdjust)
                    && request.resource.data.adjustedAt is number
                    && request.resource.data.adjustedBy == myProfile().name;
      allow update, delete: if false;
    }

    // ---- คืนยา (AppContext.tsx: commitAdjust, 'return' type — see DrugReturnRecord in
    // types.ts) — written in the SAME transaction as the floor/txs write for a patient return,
    // same append-only "durable side record" shape as usageHistory/parAdjustments above. Unlike
    // those two (admin-only imports/par changes), any active pharm/tech processes a return at
    // the counter, so this needs the same isActive()-only trust level as txs itself. ----
    match /returns/{id} {
      allow read: if isActive();
      // Bug fix (audit finding): hasOnly() added (exact field set verified against
      // commitAdjust's 'return' write path), and `by` tied to the real caller's profile name —
      // same forgery fix applied to txs/auditLog/pendingReceives/parAdjustments above.
      allow create: if isActive()
                    && request.resource.data.keys().hasOnly(['medId', 'medName', 'medCode', 'unit', 'category', 'hn', 'qty', 'unitPrice', 'value', 'reason', 'note', 'date', 'ts', 'by'])
                    && request.resource.data.medId is string
                    && request.resource.data.medName is string
                    && request.resource.data.medCode is string
                    && request.resource.data.unit is string
                    && request.resource.data.category is string
                    && request.resource.data.hn is string
                    && isNonNegNum(request.resource.data.qty)
                    && isNonNegNum(request.resource.data.unitPrice)
                    && isNonNegNum(request.resource.data.value)
                    && request.resource.data.reason is string
                    && request.resource.data.note is string
                    && request.resource.data.date is string
                    && request.resource.data.ts is number
                    && request.resource.data.by == myProfile().name;
      allow update, delete: if false;
    }

    // ---- pre-delete safety snapshots (AppContext.tsx: snapshotBeforeDelete()) ----
    // Before resetAllStockLedgers()/resetAllQuantities() delete anything, they first copy every
    // document about to be destroyed in here — an in-app undo layer that doesn't depend on
    // waiting for that day's external GitHub Actions backup (scripts/backup-firestore.mjs),
    // which can be up to ~24h stale. Holds a full copy of whatever it's protecting, so it needs
    // the same admin-only trust level as the real data — never readable/writable by pharm/tech.
    match /_preResetSnapshots/{id} {
      allow read, write: if isAdmin();
    }
  }
}
