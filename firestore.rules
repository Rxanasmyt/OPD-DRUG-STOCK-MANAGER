rules_version = '2';

// Paste this whole file into: Firebase Console → your project → Firestore Database
// → Rules tab → replace everything → Publish.
//
// Model: every signed-in Firebase Auth user gets a profile doc at
// users/{uid}. New accounts are created with role:'tech', active:false
// (pending). Nothing in meds/lots/txs/auditLog is readable or writable
// until an admin flips a user's `active` to true. The very first admin
// account has to be promoted by hand once, directly in the Firestore
// "Data" tab (see README) — there is no user yet to approve the first one.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return signedIn() && myProfile().active == true; }
    function isAdmin() { return isActive() && myProfile().role == 'admin'; }
    function isPharmOrAdmin() { return isActive() && (myProfile().role == 'pharm' || myProfile().role == 'admin'); }
    function isNonNegNum(v) { return v is number && v >= 0; }

    // ---- user profiles ----
    match /users/{uid} {
      // Anyone signed in can create their OWN profile once, at registration —
      // and only as an unapproved, non-privileged account. The server (rules)
      // forces role/active here so a client can't self-promote to admin.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.active == false
                    && request.resource.data.role == 'tech';

      // A user can read their own profile (to know if they're approved yet);
      // an admin can read/list anyone's (for the approvals screen).
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // A signed-in user may update only their own `lastLogin` field.
      // Only an admin may change role/active (approve, promote, disable).
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']));

      allow delete: if false;
    }

    // ---- username -> uid claims (login is by username, not email) ----
    // Publicly readable one-at-a-time (needed to check "is this username taken" before
    // signup, and a single username's existence isn't sensitive), but a username can only
    // ever be claimed once: the doc ID is the username, and create only matches the doc not
    // existing yet — once claimed, any further write is treated as an "update" and blocked
    // below.
    // Bug fix (security): `allow read` grants both `get` (check one username) AND `list`
    // (query the whole collection) — the app itself only ever does the former (see
    // AppContext.tsx's signup flow), but the blanket rule let anyone with no account at all
    // dump every username in the hospital system in one unauthenticated query, no guessing
    // needed — real enumeration, not just a theoretical gap. `allow get` alone still serves
    // every real use of this collection.
    match /usernames/{uname} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- master drug data: any approved staff can read. Any approved staff can also
    // update just `floor`/`lastCountTs`/`lastSubCountTs` (day-to-day stock movement —
    // transfer, adjust, count, HOSxP reconcile all touch only these; lastSubCountTs is its
    // own field, separate from lastCountTs, because floor and substock cycle counts are
    // tracked on independent staleness clocks — see CountScreen.tsx/commitSubCount in
    // AppContext.tsx). Everything else about a drug's record — creating one, deleting one,
    // par/bin/price/name/active/high-alert — real-world request: Admin only now (was
    // pharm/admin) — a pharmacist still edits day-to-day floor/count via the isActive()
    // branch below same as tech, just not the master record itself. ----
    match /meds/{medId} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      // Bug fix: this branch type-checked `floor` but not `lastCountTs`/`lastSubCountTs`,
      // inconsistent with the `lots` rule right below which type-checks every field it allows.
      // A malformed value here (string/null from a client bug or stale cache) would corrupt the
      // "days since last count" staleness calculations reports/selectors read from these fields.
      //
      // Bug fix (privilege escalation): every LEGITIMATE non-admin write to these fields
      // (commitCount/commitSubCount in AppContext.tsx) sets lastCountTs/lastSubCountTs to a
      // real Date.now() number — the only place that ever DELETES them is
      // resetAllQuantities(), which is admin-gated client-side (double confirm + typed "RESET"
      // + a pre-write backup to _preResetSnapshots) precisely because it's a hospital-wide,
      // unaudited wipe. But this rule only checked the TYPE of these fields when present —
      // deleteField() removes a field entirely, so resetAllQuantities' own exact payload
      // (`{floor: 0, lastCountTs: deleteField(), lastSubCountTs: deleteField()}`) satisfied
      // this branch just as well as a real tech's single-med count, with no role check at all.
      // Any active tech, calling the Firestore SDK directly from devtools (bypassing the admin
      // gate, the confirmations, AND the backup snapshot), could batch-zero every med's floor
      // hospital-wide with zero audit trail. Requiring that a field which already existed on
      // the med can never be REMOVED by this branch closes that exact payload shape — a
      // resetAllQuantities-style bulk wipe (or any single-doc equivalent) now needs isAdmin().
      allow update: if isAdmin()
                    || (isActive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['floor', 'lastCountTs', 'lastSubCountTs'])
                        && isNonNegNum(request.resource.data.floor)
                        && (!('lastCountTs' in resource.data) || 'lastCountTs' in request.resource.data)
                        && (!('lastSubCountTs' in resource.data) || 'lastSubCountTs' in request.resource.data)
                        && (!('lastCountTs' in request.resource.data) || request.resource.data.lastCountTs is number)
                        && (!('lastSubCountTs' in request.resource.data) || request.resource.data.lastSubCountTs is number));
    }
    // ---- lots: any approved staff can read/write (receiving, FEFO transfer, scrap
    // all touch lots as part of normal day-to-day work, not just pharm/admin). Schema-checked
    // (not just role-checked) since this is a shared-write collection — a real stock quantity,
    // not just a UI-hidden field, so it's worth blocking obviously-malformed writes (negative/
    // non-numeric qty, wrong-typed medId) at the database layer too, not just in client JS. ----
    match /lots/{lotId} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.medId is string
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.exp is number;
      // Bug fix (audit finding — real production hardening, not just type-checking): this used
      // to only type-check medId/qty/exp on every update, with no restriction on WHICH fields
      // could actually change or by how much — any active (tech-level) account calling the
      // Firestore SDK directly (devtools, a buggy/compromised third-party script) could freely
      // reassign a lot to a completely different med, or rewrite its qty to anything, with
      // nothing here distinguishing that from a real app action and no required txs row either.
      // scripts/check-stock-drift.mjs (the daily automated drift check) would eventually catch
      // the resulting discrepancy, but only up to 24h later and without attributing WHAT caused
      // it. Every real write path in this app updates lots in exactly one of two shapes — see
      // AppContext.tsx's commitTransfer/commitReceive/approvePendingReceive/scrapLot/
      // commitSubCount (qty only: a transfer, receive-merge, scrap, or count) and
      // mergeWardMeds/mergeAllWardPairs (medId only: reassigning a lot to the surviving med
      // during a ward merge) — never both in the same write, and lotNo/exp never change once a
      // lot exists (a different batch always gets its own new lot doc instead). Locking the
      // rule to exactly that shape closes the "any field, any value" gap without needing to
      // guess at a legitimate quantity ceiling (a real receipt or count can legitimately be any
      // size), which is the one part of this finding not addressed here on purpose.
      allow update: if isActive()
                    && request.resource.data.medId is string
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.exp is number
                    && request.resource.data.lotNo == resource.data.lotNo
                    && request.resource.data.exp == resource.data.exp
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'medId']);
      // Bug fix: the app itself never deletes a lot doc — every real depletion (scrap, transfer,
      // count) zeroes `qty` via a transaction that also logs a matching txs row, same pattern the
      // update rule above enforces the shape of. Letting any active (tech-level) user outright
      // delete a lot doc had no matching app feature, no schema check, and no audit requirement —
      // real stock could vanish with zero trace. Admin-only, matching every other destructive
      // action in this file (meds delete, resetAllStockLedgers' txs delete).
      allow delete: if isAdmin();
    }

    // ---- floorLots: mirrors the `lots` rule immediately above, but for stock already moved
    // onto the ward floor (see FloorLot in types.ts for why this is a separate collection from
    // `lots` rather than a stage flag on it). Written by the same day-to-day flows as `lots` —
    // commitTransfer (creates/merges one per batch drawn), commitReconcile (best-effort FEFO
    // deduction from HOSxP's dispensed number), scrapFloorLot (admin/pharm bookkeeping cleanup)
    // — so the same isActive() role gate and schema shape apply. lotNo/exp never change once a
    // doc exists, same as `lots`; medId is included in affectedKeys() for the same forward-
    // compatibility reason as `lots`, even though no current write path ever actually reassigns
    // it. ----
    match /floorLots/{lotId} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.medId is string
                    && request.resource.data.lotNo is string
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.exp is number;
      allow update: if isActive()
                    && request.resource.data.medId is string
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.exp is number
                    && request.resource.data.lotNo == resource.data.lotNo
                    && request.resource.data.exp == resource.data.exp
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'medId']);
      // The app itself never deletes a floorLots doc — scrapFloorLot() zeroes `qty` via the
      // update rule above, same as scrapLot() does for `lots`. Admin-only, matching `lots`.
      allow delete: if isAdmin();
    }

    // ---- transactions: append-only for everyone EXCEPT one admin-only escape hatch.
    // Schema-checked on create — this is the audit ledger the app treats as authoritative
    // history, so a malformed/fabricated entry (wrong-typed qty, no `by`/`ts`) shouldn't be
    // acceptable just because the writer is a signed-in active user. ----
    match /txs/{txId} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.type is string
                    && request.resource.data.qty is number
                    && request.resource.data.by is string
                    && request.resource.data.ts is number;
      allow update: if false;
      // Admin-only exception for resetAllStockLedgers() (AppContext.tsx) — the go-live
      // "start the system over" action that wipes the substock card ledger/report/usage-rate
      // history for every drug at once (current floor/lot quantities are never touched by it —
      // see that function's own doc comment). Everyone else, including a signed-in
      // pharm/tech, still can never delete a tx once written; only an admin, and only via that
      // one deliberate, double-confirmed action.
      allow delete: if isAdmin();
    }
    match /auditLog/{entryId} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.type is string
                    && request.resource.data.note is string
                    && request.resource.data.by is string
                    && request.resource.data.ts is number;
      allow update, delete: if false;
    }

    // ---- receives submitted by a ผู้ช่วยเภสัชกร (tech), waiting on a pharmacist/admin to
    // approve before they touch real stock. Any active staff can read (a tech needs to see
    // their own request's status) and create their own (status must start 'pending', and the
    // requester field must be themself — no submitting on someone else's behalf, no
    // pre-approving your own request). Only pharm/admin can update (approve/reject) — a tech
    // is intentionally excluded even from touching their own submission after the fact. ----
    match /pendingReceives/{id} {
      allow read: if isActive();
      // Bug fix: unlike every other shared-write collection here (txs/auditLog check every
      // field's type — see txs's own comment on why), this only ever checked
      // requestedByUid/status, leaving medId/qty/exp/lotNo/name/unit completely unconstrained.
      // A pendingReceives doc is exactly the kind of thing the txs comment warns about: a
      // low-privilege (tech) writer whose data later gets blindly applied to real stock —
      // approvePendingReceive() (AppContext.tsx) does `increment(pr.qty)` on a med's floor and
      // copies these same fields straight into a new txs row. A malformed qty/medId here used
      // to surface only as a confusing failed-transaction error at approval time instead of
      // being rejected up front, at the point it was actually written.
      allow create: if isActive()
                    && request.resource.data.requestedByUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.medId is string
                    && request.resource.data.name is string
                    && request.resource.data.unit is string
                    && request.resource.data.lotNo is string
                    && request.resource.data.exp is number
                    && isNonNegNum(request.resource.data.qty)
                    && request.resource.data.ts is number;
      allow update: if isPharmOrAdmin();
      allow delete: if false;
    }

    // ---- shared settings (expiry warning days, par cover days) — real-world request:
    // Admin only now (was pharm/admin) ----
    match /meta/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- daily KPI snapshots (scripts/collect-daily-metrics.mjs, see types.ts:DailyMetrics)
    // ---- written once/day by a GitHub Actions cron job using the service-account credentials
    // (which bypass these rules entirely, same as backup-firestore.mjs/notify-low-stock.mjs) —
    // never by the app itself, so client writes are denied outright rather than scoped to a
    // role. Any active user can read it (report/KPI screen). ----
    match /dailyMetrics/{date} {
      allow read: if isActive();
      allow write: if false;
    }

    // ---- usage history (AppContext.tsx: commitUsageImport, see UsageHistoryRecord in types.ts)
    // ---- the durable, append-only per-period qty/value record behind the "📈 สถิติการใช้ยา"
    // report tab. Written in the SAME action/batch as the admin-only meds.used30 update right
    // above (SettingsScreen gates that whole import UI to admin — see its own "Admin-only now"
    // comment) — matching that same isAdmin() gate here, not a wider isActive(), keeps this
    // collection's write path exactly as privileged as the used30 write it always travels with.
    // Append-only like txs: never updated, never deleted by the app (a wrong import is a new
    // record, not an edit — the report tab's own "ไม่ถูกทับด้วยการนำเข้ารอบใหม่" guarantee would
    // break the moment this allowed update/delete). ----
    match /usageHistory/{id} {
      allow read: if isActive();
      allow create: if isAdmin()
                    && request.resource.data.medId is string
                    && request.resource.data.medName is string
                    && request.resource.data.unit is string
                    && request.resource.data.category is string
                    && isNonNegNum(request.resource.data.qty)
                    && isNonNegNum(request.resource.data.value)
                    && request.resource.data.periodFrom is string
                    && request.resource.data.periodTo is string
                    && request.resource.data.periodDays is number
                    && request.resource.data.importedAt is number
                    && request.resource.data.monthKey is string;
      allow update, delete: if false;
    }

    // ---- par-adjustment outcomes (AppContext.tsx: applyOnePar/applyAllSuggested, see
    // ParAdjustmentRecord in types.ts) — same reasoning as usageHistory right above: written in
    // the SAME action as the meds.parFloor/parSub update (canEditMeds is admin-only — see its
    // own definition), append-only so a later "did it stabilize?" check can never find its own
    // evidence edited or deleted out from under it. ----
    match /parAdjustments/{id} {
      allow read: if isActive();
      allow create: if isAdmin()
                    && request.resource.data.medId is string
                    && request.resource.data.medName is string
                    && request.resource.data.category is string
                    && isNonNegNum(request.resource.data.beforeFloor)
                    && isNonNegNum(request.resource.data.beforeSub)
                    && isNonNegNum(request.resource.data.afterFloor)
                    && isNonNegNum(request.resource.data.afterSub)
                    && isNonNegNum(request.resource.data.used30AtAdjust)
                    && isNonNegNum(request.resource.data.usedPrev30AtAdjust)
                    && request.resource.data.adjustedAt is number
                    && request.resource.data.adjustedBy is string;
      allow update, delete: if false;
    }

    // ---- คืนยา (AppContext.tsx: commitAdjust, 'return' type — see DrugReturnRecord in
    // types.ts) — written in the SAME transaction as the floor/txs write for a patient return,
    // same append-only "durable side record" shape as usageHistory/parAdjustments above. Unlike
    // those two (admin-only imports/par changes), any active pharm/tech processes a return at
    // the counter, so this needs the same isActive()-only trust level as txs itself. ----
    match /returns/{id} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.medId is string
                    && request.resource.data.medName is string
                    && request.resource.data.medCode is string
                    && request.resource.data.unit is string
                    && request.resource.data.category is string
                    && request.resource.data.hn is string
                    && isNonNegNum(request.resource.data.qty)
                    && isNonNegNum(request.resource.data.unitPrice)
                    && isNonNegNum(request.resource.data.value)
                    && request.resource.data.note is string
                    && request.resource.data.date is string
                    && request.resource.data.ts is number
                    && request.resource.data.by is string;
      allow update, delete: if false;
    }

    // ---- pre-delete safety snapshots (AppContext.tsx: snapshotBeforeDelete()) ----
    // Before resetAllStockLedgers()/resetAllQuantities() delete anything, they first copy every
    // document about to be destroyed in here — an in-app undo layer that doesn't depend on
    // waiting for that day's external GitHub Actions backup (scripts/backup-firestore.mjs),
    // which can be up to ~24h stale. Holds a full copy of whatever it's protecting, so it needs
    // the same admin-only trust level as the real data — never readable/writable by pharm/tech.
    match /_preResetSnapshots/{id} {
      allow read, write: if isAdmin();
    }
  }
}
